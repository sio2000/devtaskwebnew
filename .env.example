# ─────────────────────────────────────────────────────────────
# DevTaskHub — environment variables
# ─────────────────────────────────────────────────────────────
#
# ADMIN_PASSWORD protects the /admin analytics dashboard.
# It is read ONLY server-side inside netlify/functions/stats.ts
# (NOT VITE_-prefixed), so it is never exposed in the client bundle.
#
# Set it in Netlify:  Site settings → Environment variables → Add
#   Key:   ADMIN_PASSWORD
#   Value: (ο κωδικός σου, ΠΟΤΕ μέσα σε αυτό το αρχείο)
#
# For local testing with the Netlify CLI (`netlify dev`), copy this
# file to `.env` and fill it in. NEVER commit the real `.env`.
ADMIN_PASSWORD=

# ─── Καρτέλα "Όρια πλάνων" στο /admin (netlify/functions/usage.ts) ───
# Όλα διαβάζονται ΜΟΝΟ server-side. Ό,τι λείπει εμφανίζεται ως "λείπει κλειδί".
#
# Supabase: personal access token του λογαριασμού (μέγεθος βάσης, χρήστες)
#   https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
LIFEMUSEUM_SUPABASE_URL=
LIFEMUSEUM_SUPABASE_SECRET_KEY=
LUMORA_SUPABASE_URL=
LUMORA_SUPABASE_SECRET_KEY=
#
# Neon: connection string (μέγεθος βάσης) και API key του λογαριασμού
# (compute ώρες, μεταφορά δεδομένων): Account settings → API keys
YOURBUDDYFY_DATABASE_URL=
YOURBUDDYFY_NEON_API_KEY=
HOURNOOK_DATABASE_URL=
HOURNOOK_NEON_API_KEY=
#
# Resend: API key με δικαίωμα "Full access" (το "Sending access" δεν διαβάζει χρήση)
LIFEMUSEUM_RESEND_API_KEY=
LUMORA_RESEND_API_KEY=
YOURBUDDYFY_RESEND_API_KEY=
HOURNOOK_RESEND_API_KEY=
